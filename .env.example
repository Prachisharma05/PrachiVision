# Create your own Supabase project; never reuse the template project's values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional email delivery. Without these, the contact form opens the visitor's
# email app, addressed to the public email entered in the admin profile.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
